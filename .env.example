# Miljövariabler för Skogsprataren (/api/ai). Kopiera till .env för lokal
# testning med `netlify dev`, eller lägg in dem i värdens gränssnitt:
#   Netlify: Site configuration → Environment variables (scope: Functions)
#   Vercel:  Project → Settings → Environment Variables
#
# Nyckeln läses bara av serverfunktionen. Den når aldrig webbläsaren och
# loggas aldrig. Sätt aldrig en nyckel i src/ eller i ett VITE_-namn.

# Vilken tjänst som anropas: "openai" (OpenAI-kompatibelt, standard) eller "anthropic".
AI_PROVIDER=openai

# Nyckeln. OPENAI_API_KEY eller ANTHROPIC_API_KEY fungerar också, liksom de
# nycklar Netlify AI Gateway injicerar automatiskt.
AI_API_KEY=

# Modell och eventuell annan basadress.
AI_MODEL=gpt-4o-mini
# AI_API_URL=https://api.openai.com/v1
# AI_API_URL=https://openrouter.ai/api/v1
# AI_API_URL=https://api.anthropic.com
